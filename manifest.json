{
  "manifest_version": 3,
  "name": "Sentence Grader for Google Forms",
  "version": "1.0.1",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "description": "Preview sentence counts and fill blank Google Forms quiz scores for teacher review.",
  "content_scripts": [
    {
      "matches": ["https://docs.google.com/forms/d/*/edit*"],
      "css": ["vendor/tippy.css", "vendor/tippy-theme.css"],
      "js": ["vendor/popper.min.js", "vendor/tippy.umd.min.js", "grader.js", "confetti.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
